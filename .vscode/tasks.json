{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Start Expo",
      "type": "shell",
      "command": "npm start",
      "isBackground": true,
      "problemMatcher": {
        "pattern": {
          "regexp": "^(.*)$",
          "file": 1
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "Starting Metro Bundler",
          "endsPattern": "Metro Bundler ready"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "new"
      }
    },
    {
      "label": "Run iOS",
      "type": "shell",
      "command": "npm run ios",
      "problemMatcher": [],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "new"
      }
    },
    {
      "label": "Run Android",
      "type": "shell",
      "command": "npm run android",
      "problemMatcher": [],
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "new"
      }
    },
    {
      "label": "Clear Cache and Start",
      "type": "shell",
      "command": "npm start -- --clear",
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "new"
      }
    },
    {
      "label": "Install Dependencies",
      "type": "shell",
      "command": "npm install",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always"
      }
    },
    {
      "label": "TypeScript Check",
      "type": "shell",
      "command": "npx tsc --noEmit",
      "problemMatcher": "$tsc",
      "group": "build",
      "presentation": {
        "reveal": "always"
      }
    },
    {
      "label": "Expo Prebuild (Generate Native Code)",
      "type": "shell",
      "command": "npx expo prebuild",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always"
      }
    },
    {
      "label": "Install iOS Pods",
      "type": "shell",
      "command": "cd ios && pod install && cd ..",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always"
      }
    },
    {
      "label": "Clean iOS Build",
      "type": "shell",
      "command": "cd ios && rm -rf build Pods Podfile.lock && pod install && cd ..",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always"
      }
    }
  ]
}
